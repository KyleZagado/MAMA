{
  "expo": {
    "name": "MAMA",
    "slug": "MAMA",
    "version": "1.0.0",
    "scheme": "mama",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kylezagado.mama",
      "supportsTablet": true
    },
    "android": {
      "package": "com.kylezagado.mama",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "defaultChannel": "workout-reminders"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "MAMA accesses your photos so you can choose a profile picture.",
          "cameraPermission": "MAMA uses your camera so you can photograph your meals.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MAMA uses your location to record the distance and route of your runs, walks and rides.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "MAMA counts your steps while you record an activity."
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "MamaWidget",
              "displayName": "MAMA Today",
              "description": "Your balance, today's tasks and water intake",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MamaWidget",
              "label": "MAMA Today",
              "description": "Your balance, today's tasks and water intake",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
